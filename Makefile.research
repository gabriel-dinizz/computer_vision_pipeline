# Academic Research Makefile for OpenMP Performance Analysis

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    CXX := clang++
    BREW_PREFIX := $(shell brew --prefix)
    OMP_FLAGS := -Xpreprocessor -fopenmp -I$(BREW_PREFIX)/opt/libomp/include -L$(BREW_PREFIX)/opt/libomp/lib -lomp
else
    CXX := g++
    OMP_FLAGS := -fopenmp
endif

OPENCV_FLAGS := $(shell pkg-config --cflags --libs opencv4 || pkg-config --cflags --libs opencv)
CXXFLAGS := -std=c++17 -O3 -Wall -Wextra $(OMP_FLAGS) $(OPENCV_FLAGS)

.PHONY: research-build research-benchmark research-report clean-research

research-build:
	@mkdir -p bin results
	$(CXX) $(CXXFLAGS) -o bin/preprocess src/preprocess.cpp
	@echo "Research build complete"

research-benchmark: research-build
	@echo "Running OpenMP performance analysis..."
	python3 research_benchmark.py
	@echo "Benchmark complete. Results in results/"

research-report: research-benchmark
	@echo "Generating research report..."
	python3 -c "
import pandas as pd
import glob

print('# OpenMP Parallelization Performance Analysis\\n')
for csv_file in glob.glob('results/openmp_data_*.csv'):
    filter_name = csv_file.split('_')[-1].replace('.csv', '')
    df = pd.read_csv(csv_file)
    max_speedup = df['speedup'].max()
    efficiency_8 = df[df['threads']==8]['efficiency'].iloc[0]
    print(f'## {filter_name.upper()} Filter')
    print(f'- Maximum Speedup: {max_speedup:.2f}x')
    print(f'- Efficiency at 8 threads: {efficiency_8:.2f}')
    print(f'- Baseline time (1 thread): {df[df[\"threads\"]==1][\"mean_time_ms\"].iloc[0]:.2f}ms')
    print()
" > results/research_report.md
	@echo "Report generated: results/research_report.md"

clean-research:
	rm -rf bin results temp
